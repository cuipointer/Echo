{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/*.py)",
      "Bash(python3 tools/*.py *)",
      "Bash(bash tools/*.sh)",
      "Bash(bash tools/*.sh *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
